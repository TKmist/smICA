{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smica.local/schemas/automation-request-v1.schema.json",
  "title": "smICA automation request version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "request_id",
    "command",
    "parameters"
  ],
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "command": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$",
      "maxLength": 96
    },
    "parameters": {
      "type": "object"
    },
    "authentication_token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  }
}
