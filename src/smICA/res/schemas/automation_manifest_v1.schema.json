{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smica.local/schemas/automation-manifest-v1.schema.json",
  "title": "smICA workflow result manifest version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_schema_version",
    "smica",
    "runtime",
    "workflow",
    "started_at",
    "ended_at",
    "status",
    "inputs",
    "outputs",
    "files",
    "warnings"
  ],
  "properties": {
    "manifest_schema_version": {
      "const": 1
    },
    "smica": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "source_revision": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "python",
        "dependencies"
      ],
      "properties": {
        "python": {
          "type": "string"
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "workflow": {
      "type": "object"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file_record"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file_record"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "input",
          "status"
        ],
        "properties": {
          "input": {
            "type": "string"
          },
          "status": {
            "enum": [
              "completed",
              "failed",
              "skipped"
            ]
          },
          "ptu_metadata": {
            "type": "object"
          },
          "counts": {
            "type": "object"
          },
          "frame_selection": {
            "type": [
              "object",
              "null"
            ]
          },
          "filtering": {
            "type": "object"
          },
          "calibration": {
            "type": "object"
          },
          "roi": {
            "type": "object"
          },
          "results": {
            "type": "object"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "failure": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "file_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
